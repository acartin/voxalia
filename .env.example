# Voxalia environment example
# Copy to .env and replace every change-me value before running services.

# Voxalia runtime
VOXALIA_ENV=local
VOXALIA_LOG_LEVEL=info
VOXALIA_SECRET_KEY=change-me
VOXALIA_INTERNAL_TOKEN=change-me
VOXALIA_PUBLIC_APP_URL=http://localhost:8320
VOXALIA_PUBLIC_VOICE_URL=ws://192.168.10.37:8088/ws

# Voxalia web
VOXALIA_WEB_PORT=8320
VOXALIA_API_BASE_URL=http://voxalia-web-api:8000/api/v1
VOXALIA_PLACEHOLDER_AUTH=false
VOXALIA_SECURE_COOKIES=false

# Voxalia web API
VOXALIA_WEB_API_PORT=8330
VOXALIA_BOOTSTRAP_ADMIN_USERNAME=admin
VOXALIA_BOOTSTRAP_ADMIN_EMAIL=admin@voxalia.local
VOXALIA_BOOTSTRAP_ADMIN_PASSWORD=change-me

# PostgreSQL
POSTGRES_PORT=8432
POSTGRES_BOOTSTRAP_DB=chatwoot
POSTGRES_BOOTSTRAP_USER=voxalia
POSTGRES_BOOTSTRAP_PASSWORD=change-me
POSTGRES_ADMIN_USER=voxalia_admin
POSTGRES_ADMIN_PASSWORD=change-me

# Voxalia application database
VOXALIA_DATABASE_URL=postgresql://voxalia_app:change-me@postgres:5432/voxalia
VOXALIA_APP_DB=voxalia
VOXALIA_APP_DB_USER=voxalia_app
VOXALIA_APP_DB_PASSWORD=change-me

# Redis
VOXALIA_REDIS_URL=redis://redis:6379/0

# Chatwoot
CHATWOOT_PORT=8300
CHATWOOT_FRONTEND_URL=http://localhost:8300
CHATWOOT_SECRET_KEY_BASE=change-me
CHATWOOT_DB=chatwoot
CHATWOOT_DB_USER=chatwoot_app
CHATWOOT_DB_PASSWORD=change-me

# FreePBX / Asterisk
FREEPBX_TZ=America/Costa_Rica
FREEPBX_HTTP_PORT=8310
FREEPBX_HTTPS_PORT=8311
FREEPBX_ASTERISK_WS_PORT=8088
FREEPBX_ASTERISK_WSS_PORT=8089
FREEPBX_SIP_PORT=5062
FREEPBX_RTP_START=12000
FREEPBX_RTP_END=12100
FREEPBX_MYSQL_ROOT_PASSWORD=change-me
FREEPBX_MYSQL_USER=freepbxuser
FREEPBX_MYSQL_PASSWORD=change-me

# WebRTC / TURN
VOXALIA_STUN_URLS=
VOXALIA_TURN_URLS=
VOXALIA_TURN_REALM=
VOXALIA_TURN_SECRET=change-me
VOXALIA_RTP_PUBLIC_IP=

# AI providers
VOXALIA_AI_GOOGLE_API_KEY=
VOXALIA_AI_OPENROUTER_API_KEY=
VOXALIA_AI_EMBEDDING_MODEL=
VOXALIA_AI_VISION_MODEL=
VOXALIA_AI_DEFAULT_MODEL=
VOXALIA_AI_ANALYZE_TURN_MODEL=
VOXALIA_AI_TIMEOUT_SECS=60

# Mail
VOXALIA_MAIL_PROVIDER=
VOXALIA_BREVO_API_KEY=
VOXALIA_BREVO_API_BASE_URL=
VOXALIA_MAIL_FROM_EMAIL=
VOXALIA_MAIL_FROM_NAME=
