# Voxalia
VOXALIA_ENV=local
VOXALIA_LOG_LEVEL=info
VOXALIA_SECRET_KEY=change-me

# PostgreSQL
POSTGRES_PORT=8432
POSTGRES_BOOTSTRAP_DB=chatwoot
POSTGRES_BOOTSTRAP_USER=voxalia
POSTGRES_BOOTSTRAP_PASSWORD=change-me
POSTGRES_ADMIN_USER=voxalia_admin
POSTGRES_ADMIN_PASSWORD=change-me

# Chatwoot database
CHATWOOT_DB=chatwoot
CHATWOOT_DB_USER=chatwoot_app
CHATWOOT_DB_PASSWORD=change-me

# Voxalia application database
VOXALIA_DATABASE_URL=postgresql://voxalia_app:change-me@postgres:5432/voxalia
VOXALIA_APP_DB=voxalia
VOXALIA_APP_DB_USER=voxalia_app
VOXALIA_APP_DB_PASSWORD=change-me

# Redis
VOXALIA_REDIS_URL=redis://redis:6379/0

# Chatwoot
CHATWOOT_PORT=8300
CHATWOOT_FRONTEND_URL=http://localhost:8300
CHATWOOT_SECRET_KEY_BASE=change-me-use-openssl-rand-hex-64

# FreePBX / Asterisk
FREEPBX_TZ=America/Costa_Rica
FREEPBX_HTTP_PORT=8310
FREEPBX_HTTPS_PORT=8311
FREEPBX_SIP_PORT=5062
FREEPBX_RTP_START=12000
FREEPBX_RTP_END=12100
FREEPBX_MYSQL_ROOT_PASSWORD=change-me
FREEPBX_MYSQL_USER=freepbxuser
FREEPBX_MYSQL_PASSWORD=change-me

# Internal service auth
VOXALIA_INTERNAL_TOKEN=change-me
